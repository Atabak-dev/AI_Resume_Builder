# Copy this file to .env and fill in your values. .env is gitignored.
# Connection details live here (not in llm_config.json) so a private endpoint
# is never committed. llm_config.json holds only sampling parameters.

LLM_API_KEY=your-api-key-here

# OpenAI-compatible endpoint. Example for api.openai.com:
#   LLM_HOST=api.openai.com
#   LLM_BASE_PATH=/v1/chat/completions
#   LLM_ENDPOINT=https://api.openai.com
LLM_MODEL=your-model-name
LLM_HOST=your.llm.host
LLM_BASE_PATH=/v1/chat/completions
LLM_ENDPOINT=https://your.llm.host

# Web search backend(s) for company research (src/utils/search.py).
# Keyed real-API providers only - brave, tavily, serper. There is no keyless
# default: a prior version scraped DuckDuckGo/Bing's HTML search pages, but
# DuckDuckGo hard-blocks with a bot-challenge on most networks and Bing was
# found to silently serve well-formed result pages for a totally unrelated
# query (see CLAUDE.md "Known rough edges"). Feeding that into research is
# worse than no research, so both were removed.
#
# Without an API key here, the app will prompt you to paste the company's
# official website by hand instead of searching for it automatically.
#
# Unset or "auto" = try every provider below that has a key set (brave,
# then tavily, then serper). A single name prioritises that provider ahead
# of the others; a comma-separated list sets an exact order (remaining
# defaults still follow); the "only:" prefix pins one provider, no fallback.
#   SEARCH_PROVIDER=                # auto: brave -> tavily -> serper (whichever have keys)
#   SEARCH_PROVIDER=serper          # serper first, then the others if serper has no key
#   SEARCH_PROVIDER=only:brave      # brave only, no fallback
#
# Recommended: Brave Search API - 2,000 queries/month free, no credit card.
# Sign up at https://brave.com/search/api/ and paste the key below.
BRAVE_API_KEY=
# Alternatives:
#   Tavily  - 1,000 queries/month free  - https://tavily.com
#   Serper  - 2,500 one-time credits    - https://serper.dev
SEARCH_PROVIDER=
# TAVILY_API_KEY=
# SERPER_API_KEY=
