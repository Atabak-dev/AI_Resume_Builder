# Copy this file to .env and fill in your values. .env is gitignored.
# Connection details live here (not in llm_config.json) so a private endpoint
# is never committed. llm_config.json holds only sampling parameters.

LLM_API_KEY=your-api-key-here

# OpenAI-compatible endpoint. Example for api.openai.com:
#   LLM_HOST=api.openai.com
#   LLM_BASE_PATH=/v1/chat/completions
#   LLM_ENDPOINT=https://api.openai.com
LLM_MODEL=your-model-name
LLM_HOST=your.llm.host
LLM_BASE_PATH=/v1/chat/completions
LLM_ENDPOINT=https://your.llm.host

# Web search backend(s) for company research (src/utils/search.py).
# Unset or "auto" = try duckduckgo, then bing (both keyless, no signup), with
# any keyed provider whose API key is set tried first. A single name
# prioritises that provider ahead of the defaults; a comma-separated list
# sets an exact order (remaining defaults still follow); the "only:" prefix
# pins one provider with no fallback.
#   SEARCH_PROVIDER=                # auto: duckduckgo -> bing
#   SEARCH_PROVIDER=brave           # brave -> duckduckgo -> bing
#   SEARCH_PROVIDER=bing,brave      # exact order, then remaining defaults
#   SEARCH_PROVIDER=only:duckduckgo # duckduckgo only, no fallback
# Keyless: duckduckgo, bing | Keyed: brave, tavily, serper
SEARCH_PROVIDER=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
